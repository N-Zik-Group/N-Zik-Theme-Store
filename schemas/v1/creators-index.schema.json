{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "creators"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "creators": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "githubId",
          "profileSha256"
        ],
        "properties": {
          "githubId": {
            "type": "integer",
            "minimum": 1
          },
          "profileSha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
          }
        }
      }
    }
  }
}
