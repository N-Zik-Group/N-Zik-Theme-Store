{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/N-Zik-Group/N-Zik-Theme-Store/main/schemas/v1/theme.schema.json",
  "title": "N-Zik theme manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "themeId",
    "revision",
    "title",
    "description",
    "author",
    "license",
    "tags",
    "compatibility",
    "appearance",
    "previews"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "themeId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}(?![\\s\\S])"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "author": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "githubId",
        "login"
      ],
      "properties": {
        "githubId": {
          "type": "integer",
          "minimum": 1
        },
        "login": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9-]{0,38}(?![\\s\\S])"
        }
      }
    },
    "license": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9.+-]{0,99}(?![\\s\\S])"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 30
      },
      "maxItems": 8,
      "uniqueItems": true
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "minVersionCode"
      ],
      "properties": {
        "minVersionCode": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "description": "Minimum version code with import support, or null while compatibility is pending."
        }
      }
    },
    "appearance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "const": "appearance.json"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
        }
      }
    },
    "previews": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "role",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^previews/[a-z0-9][a-z0-9_-]{0,79}\\.(jpg|png|webp|gif)(?![\\s\\S])"
          },
          "role": {
            "enum": [
              "player",
              "queue",
              "navigation",
              "other"
            ]
          },
          "caption": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
          }
        }
      },
      "maxItems": 36
    }
  }
}
