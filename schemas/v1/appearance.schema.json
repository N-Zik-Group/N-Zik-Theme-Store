{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/N-Zik-Group/N-Zik-Theme-Store/main/schemas/v1/appearance.schema.json",
  "title": "N-Zik theme appearance v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "categories"],
  "properties": {
    "schemaVersion": {"const": 1},
    "categories": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "colors": {
          "type": "object",
          "additionalProperties": false,
          "required": ["palette", "mode"],
          "properties": {
            "palette": {
              "enum": ["default", "dynamic", "pure-black", "modern-black", "material-you"]
            },
            "mode": {
              "enum": ["light", "dark", "system", "pitch-black"]
            }
          }
        },
        "playerAndQueue": {
          "type": "object",
          "additionalProperties": false,
          "required": ["playerStyle", "queueStyle", "coverStyle", "headerStyle", "controlsStyle", "background", "timeline", "showQueueDuration"],
          "properties": {
            "playerStyle": {
              "enum": ["essential", "modern"]
            },
            "queueStyle": {
              "enum": ["essential", "modern"]
            },
            "coverStyle": {
              "enum": ["essential", "modern"]
            },
            "headerStyle": {
              "enum": ["essential", "modern"]
            },
            "controlsStyle": {
              "enum": ["essential", "modern"]
            },
            "background": {
              "enum": ["cover-color", "theme-color", "cover-color-gradient", "theme-color-gradient", "blurred-cover-color", "color-palette", "animated-gradient"]
            },
            "timeline": {
              "enum": ["default", "wavy", "pin-bar", "bodied-bar", "audio-waves", "thin-bar", "colored-bar", "visualizer-bar"]
            },
            "showQueueDuration": {"type": "boolean"}
          }
        },
        "navigation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["position", "labels"],
          "properties": {
            "position": {
              "enum": ["left", "right", "top", "bottom", "bottom-floating"]
            },
            "labels": {
              "enum": ["icon-and-text", "icon-only"]
            }
          }
        },
        "glass": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "tintSource", "navigation", "miniPlayer", "nowPlaying"],
          "properties": {
            "enabled": {"type": "boolean"},
            "tintSource": {
              "enum": ["none", "theme-accent", "artwork", "system-accent"]
            },
            "navigation": {
              "enum": ["disabled", "contour-only", "glass-only", "glass-and-contour"]
            },
            "miniPlayer": {
              "enum": ["disabled", "contour-only", "glass-only", "glass-and-contour"]
            },
            "nowPlaying": {
              "enum": ["disabled", "contour-only", "glass-only", "glass-and-contour"]
            }
          }
        }
      },
      "minProperties": 1
    }
  }
}
